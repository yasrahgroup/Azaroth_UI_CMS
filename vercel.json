{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "env": {
    "MEDIA_STORAGE_MODE": {
      "development": "local",
      "preview": "test",
      "production": "prod"
    },
    "NODE_ENV": {
      "preview": "production",
      "production": "production"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}