BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
BREVO_SMTP_HOST=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_PORT=
BREVO_SMTP_USERNAME=
CONTACT_NOTIFICATION_EMAIL=
DATABASE_URL=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
JWT_SECRET=
PORT=8080
MAX_FILE_SIZE_MB=
UPLOAD_DIR=

# --- Media storage mode ---
#   local  = local disk (development). Default.
#   test   = isolated local disk (Vercel test / CI). NEVER uses S3/R2.
#   prod   = S3-compatible object store (Cloudflare R2). Only prod may write
#            to the production bucket.
# Copy one of the committed templates: .env.local / .env.test / .env.prod
MEDIA_STORAGE_MODE=local

# Legacy single flag (kept for backwards compatibility). When
# MEDIA_STORAGE_MODE is unset and MEDIA_STORAGE=s3, S3 is used. Prefer
# MEDIA_STORAGE_MODE so a test deployment can never reach a production bucket.
MEDIA_STORAGE=disk

# --- S3 / Cloudflare R2 (only used when MEDIA_STORAGE_MODE=prod) ---
S3_BUCKET=
S3_REGION=
S3_R2=false
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PUBLIC_BASE_URL=
S3_PREFIX=uploads
S3_FORCE_PATH_STYLE=